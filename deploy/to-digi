#!/usr/bin/env bash
set -u

DEFAULT_IMAGE="ghcr.io/johed-velca/to-digi-rs:0.9.0"
DOCKER_BIN="${DOCKER_BIN:-docker}"
COMPOSE_PROJECT_NAME="to-digi-rs-import"
CONTAINER_OUTPUT_FILE=""

fail() {
    printf 'ERROR: %s\n' "$1" >&2
    exit "${2:-2}"
}

warn() {
    printf 'WARNING: %s\n' "$1" >&2
}

is_cli_usage_failure() {
    local code="$1"
    [ "$code" -eq 2 ] || return 1
    [ -n "$CONTAINER_OUTPUT_FILE" ] || return 1
    [ -f "$CONTAINER_OUTPUT_FILE" ] || return 1
    grep -Eq '(^|[[:space:]])error:|Usage:' "$CONTAINER_OUTPUT_FILE"
}

resolve_script_dir() {
    local source="${BASH_SOURCE[0]}"
    while [ -L "$source" ]; do
        local dir
        dir="$(cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd)" || return 1
        source="$(readlink "$source")"
        case "$source" in
            /*) ;;
            *) source="$dir/$source" ;;
        esac
    done
    cd -P "$(dirname "$source")" >/dev/null 2>&1 && pwd
}

require_linux() {
    if [ "${TO_DIGI_RS_ALLOW_NON_LINUX_FOR_TESTS:-}" = "1" ]; then
        return 0
    fi
    case "$(uname -s)" in
        Linux) ;;
        *) fail "to-digi must be executed from Ubuntu, WSL 2, or another Linux shell." 2 ;;
    esac
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1" 2
}

test_tty_override_enabled() {
    [ "${TO_DIGI_RS_ALLOW_NON_LINUX_FOR_TESTS:-}" = "1" ]
}

host_stdout_is_tty() {
    [ -t 1 ] && return 0
    test_tty_override_enabled && [ "${TO_DIGI_RS_TEST_STDOUT_TTY:-}" = "1" ]
}

host_stdin_is_tty() {
    [ -t 0 ] && return 0
    test_tty_override_enabled && [ "${TO_DIGI_RS_TEST_STDIN_TTY:-}" = "1" ]
}

requires_container_stdin() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --config-secret-stdin|--config-secret-stdin=*|--config_secret_stdin|--config_secret_stdin=*) return 0 ;;
        esac
    done
    return 1
}

command_label() {
    if has_arg_name "--help" "$@" || has_arg_name "-h" "$@"; then
        printf 'info\n'
        return 0
    fi
    case "${1:-import}" in
        import)
            if has_arg_name "--dry-run" "$@"; then
                printf 'dry-run\n'
            elif has_resume_arg "$@"; then
                printf 'resume\n'
            else
                printf 'import\n'
            fi
            ;;
        resume) printf 'resume\n' ;;
        analyze|confirm|diagnose|discover|dry-run|map-audit|profile|sanitize|verify|test-connection|doctor|pull|init|version) printf '%s\n' "$1" ;;
        --help|-h|--version|-V) printf 'info\n' ;;
        *) printf 'cli\n' ;;
    esac
}

has_arg_name() {
    local name="$1"
    shift
    local arg
    for arg in "$@"; do
        case "$arg" in
            "$name"|"$name"=*) return 0 ;;
        esac
    done
    return 1
}

has_resume_arg() {
    has_arg_name "--resume" "$@"
}

path_arg_value() {
    local name="$1"
    shift
    local previous=""
    local arg
    for arg in "$@"; do
        if [ "$previous" = "$name" ]; then
            printf '%s\n' "$arg"
            return 0
        fi
        case "$arg" in
            "$name"=*)
                printf '%s\n' "${arg#*=}"
                return 0
                ;;
            "$name") previous="$name" ;;
        esac
    done
    return 1
}

resume_arg_value() {
    if [ "${1:-}" = "resume" ]; then
        [ "$#" -ge 2 ] || return 1
        printf '%s\n' "$2"
        return 0
    fi
    path_arg_value "--resume" "$@"
}

needs_config() {
    case "${1:-import}" in
        import|resume|confirm|verify|test-connection|doctor) return 0 ;;
        *) return 1 ;;
    esac
}

needs_source_mdb() {
    case "${1:-import}" in
        import|resume|analyze|confirm|diagnose|discover|dry-run|map-audit|profile|verify|sanitize|doctor) return 0 ;;
        *) return 1 ;;
    esac
}

resolve_safe_deploy_path() {
    local value="$1"
    local label="$2"
    local host_path=""
    case "$value" in
        /*) host_path="$value" ;;
        *) host_path="$SCRIPT_DIR/$value" ;;
    esac
    local parent
    parent="$(cd -P "$(dirname "$host_path")" >/dev/null 2>&1 && pwd)" || fail "Missing $label: $value" 2
    host_path="$parent/$(basename "$host_path")"
    case "$host_path/" in
        "$SCRIPT_DIR"/*) ;;
        *) fail "$label must be located inside the deployment directory." 2 ;;
    esac
    [ ! -L "$host_path" ] || fail "$label must be a regular file, not a symbolic link: $host_path" 2
    [ -f "$host_path" ] || fail "Missing $label: $host_path" 2
    [ -r "$host_path" ] || fail "$label is not readable: $host_path" 2
    printf '%s\n' "$host_path"
}

container_path_for_host_path() {
    local host_path="$1"
    printf '/work%s\n' "${host_path#"$SCRIPT_DIR"}"
}

translate_path_arg() {
    local name="$1"
    local translated_path="$2"
    shift 2
    local previous=""
    FORWARDED_ARGS=()
    local arg
    for arg in "$@"; do
        if [ "$previous" = "$name" ]; then
            FORWARDED_ARGS+=("$translated_path")
            previous=""
            continue
        fi
        case "$arg" in
            "$name"=*) FORWARDED_ARGS+=("$name=$translated_path") ;;
            "$name")
                FORWARDED_ARGS+=("$arg")
                previous="$name"
                ;;
            *) FORWARDED_ARGS+=("$arg") ;;
        esac
    done
}

translate_resume_args() {
    local translated_manifest="$1"
    shift
    FORWARDED_ARGS=()
    if [ "${1:-}" = "resume" ]; then
        FORWARDED_ARGS+=("resume" "$translated_manifest")
        shift 2
        while [ "$#" -gt 0 ]; do
            FORWARDED_ARGS+=("$1")
            shift
        done
        return 0
    fi
    translate_path_arg "--resume" "$translated_manifest" "$@"
}

validate_local_inputs() {
    if needs_config "${1:-import}"; then
        [ -f "$SCRIPT_DIR/config.toml" ] || fail "Missing required configuration file:
$SCRIPT_DIR/config.toml

Run ./to-digi init, then use ./to-digi import --config-ip IP --config-secret." 2
        [ -r "$SCRIPT_DIR/config.toml" ] || fail "config.toml is not readable: $SCRIPT_DIR/config.toml" 2
    fi
    if needs_source_mdb "${1:-import}"; then
        [ ! -L "$SCRIPT_DIR/plu.mdb" ] || fail "plu.mdb must be a regular file, not a symbolic link: $SCRIPT_DIR/plu.mdb" 2
        [ -e "$SCRIPT_DIR/plu.mdb" ] || fail "Missing required source database:
$SCRIPT_DIR/plu.mdb

Place the customer database beside ./to-digi using the exact filename plu.mdb." 2
        [ -f "$SCRIPT_DIR/plu.mdb" ] || fail "plu.mdb must be a regular file: $SCRIPT_DIR/plu.mdb" 2
        [ -r "$SCRIPT_DIR/plu.mdb" ] || fail "plu.mdb is not readable by the invoking user: $SCRIPT_DIR/plu.mdb" 2
    fi
}

clean_transient_outputs() {
    rm -f "$SCRIPT_DIR/logs.txt" || fail "Unable to clean transient logs.txt before execution." 2
    rm -f "$SCRIPT_DIR/analysis-report.txt" || fail "Unable to clean transient analysis-report.txt before execution." 2
    rm -f "$SCRIPT_DIR/analysis-report.json" || fail "Unable to clean transient analysis-report.json before execution." 2
    rm -f "$SCRIPT_DIR/discovery-report.txt" || fail "Unable to clean transient discovery-report.txt before execution." 2
    rm -f "$SCRIPT_DIR/discovery-report.json" || fail "Unable to clean transient discovery-report.json before execution." 2
    rm -f "$SCRIPT_DIR/diagnostics-report.txt" || fail "Unable to clean transient diagnostics-report.txt before execution." 2
    rm -f "$SCRIPT_DIR/diagnostics-report.json" || fail "Unable to clean transient diagnostics-report.json before execution." 2
    rm -f "$SCRIPT_DIR/dry-run-report.txt" || fail "Unable to clean transient dry-run-report.txt before execution." 2
    rm -f "$SCRIPT_DIR/dry-run-manifest.json" || fail "Unable to clean transient dry-run-manifest.json before execution." 2
    rm -f "$SCRIPT_DIR/verify-report.txt" || fail "Unable to clean transient verify-report.txt before execution." 2
    rm -f "$SCRIPT_DIR/verify-report.json" || fail "Unable to clean transient verify-report.json before execution." 2
    rm -f "$SCRIPT_DIR/mapping-report.txt" || fail "Unable to clean transient mapping-report.txt before execution." 2
    rm -f "$SCRIPT_DIR/mapping-report.json" || fail "Unable to clean transient mapping-report.json before execution." 2
    rm -f "$SCRIPT_DIR/profile-recommendations.txt" || fail "Unable to clean transient profile-recommendations.txt before execution." 2
    rm -f "$SCRIPT_DIR/sanitization-report.txt" || fail "Unable to clean transient sanitization-report.txt before execution." 2
    rm -f "$SCRIPT_DIR/sanitization-report.json" || fail "Unable to clean transient sanitization-report.json before execution." 2
    rm -f "$SCRIPT_DIR/sanitization-profile.snapshot.toml" || fail "Unable to clean transient sanitization-profile.snapshot.toml before execution." 2
    rm -rf "$SCRIPT_DIR/payload-previews" || fail "Unable to clean transient payload-previews before execution." 2
}

archive_outputs() {
    local import_exit_code="$1"
    local log_path=""
    if [ -f "$SCRIPT_DIR/logs.txt" ]; then
        mv "$SCRIPT_DIR/logs.txt" "$RUN_DIR/logs.txt" || warn "Could not archive logs.txt to $RUN_DIR"
        log_path="$RUN_DIR/logs.txt"
    elif [ "$COMMAND_LABEL" != "info" ] && ! is_cli_usage_failure "$import_exit_code"; then
        warn "Importer did not create logs.txt."
    fi

    local analysis_path=""
    if [ -f "$SCRIPT_DIR/analysis-report.txt" ]; then
        mv "$SCRIPT_DIR/analysis-report.txt" "$RUN_DIR/analysis-report.txt" || warn "Could not archive analysis-report.txt to $RUN_DIR"
        analysis_path="$RUN_DIR/analysis-report.txt"
    fi
    local analysis_json_path=""
    if [ -f "$SCRIPT_DIR/analysis-report.json" ]; then
        mv "$SCRIPT_DIR/analysis-report.json" "$RUN_DIR/analysis-report.json" || warn "Could not archive analysis-report.json to $RUN_DIR"
        analysis_json_path="$RUN_DIR/analysis-report.json"
    fi
    local discovery_path=""
    if [ -f "$SCRIPT_DIR/discovery-report.txt" ]; then
        mv "$SCRIPT_DIR/discovery-report.txt" "$RUN_DIR/discovery-report.txt" || warn "Could not archive discovery-report.txt to $RUN_DIR"
        discovery_path="$RUN_DIR/discovery-report.txt"
    fi
    local discovery_json_path=""
    if [ -f "$SCRIPT_DIR/discovery-report.json" ]; then
        mv "$SCRIPT_DIR/discovery-report.json" "$RUN_DIR/discovery-report.json" || warn "Could not archive discovery-report.json to $RUN_DIR"
        discovery_json_path="$RUN_DIR/discovery-report.json"
    fi
    local diagnostics_path=""
    if [ -f "$SCRIPT_DIR/diagnostics-report.txt" ]; then
        mv "$SCRIPT_DIR/diagnostics-report.txt" "$RUN_DIR/diagnostics-report.txt" || warn "Could not archive diagnostics-report.txt to $RUN_DIR"
        diagnostics_path="$RUN_DIR/diagnostics-report.txt"
    fi
    local diagnostics_json_path=""
    if [ -f "$SCRIPT_DIR/diagnostics-report.json" ]; then
        mv "$SCRIPT_DIR/diagnostics-report.json" "$RUN_DIR/diagnostics-report.json" || warn "Could not archive diagnostics-report.json to $RUN_DIR"
        diagnostics_json_path="$RUN_DIR/diagnostics-report.json"
    fi
    local dry_run_path=""
    if [ -f "$SCRIPT_DIR/dry-run-report.txt" ]; then
        mv "$SCRIPT_DIR/dry-run-report.txt" "$RUN_DIR/dry-run-report.txt" || warn "Could not archive dry-run-report.txt to $RUN_DIR"
        dry_run_path="$RUN_DIR/dry-run-report.txt"
    fi
    local dry_run_manifest_path=""
    if [ -f "$SCRIPT_DIR/dry-run-manifest.json" ]; then
        mv "$SCRIPT_DIR/dry-run-manifest.json" "$RUN_DIR/dry-run-manifest.json" || warn "Could not archive dry-run-manifest.json to $RUN_DIR"
        chmod 600 "$RUN_DIR/dry-run-manifest.json" 2>/dev/null || true
        dry_run_manifest_path="$RUN_DIR/dry-run-manifest.json"
    fi
    local verify_path=""
    if [ -f "$SCRIPT_DIR/verify-report.txt" ]; then
        mv "$SCRIPT_DIR/verify-report.txt" "$RUN_DIR/verify-report.txt" || warn "Could not archive verify-report.txt to $RUN_DIR"
        verify_path="$RUN_DIR/verify-report.txt"
    fi
    local verify_json_path=""
    if [ -f "$SCRIPT_DIR/verify-report.json" ]; then
        mv "$SCRIPT_DIR/verify-report.json" "$RUN_DIR/verify-report.json" || warn "Could not archive verify-report.json to $RUN_DIR"
        verify_json_path="$RUN_DIR/verify-report.json"
    fi
    local mapping_path=""
    if [ -f "$SCRIPT_DIR/mapping-report.txt" ]; then
        mv "$SCRIPT_DIR/mapping-report.txt" "$RUN_DIR/mapping-report.txt" || warn "Could not archive mapping-report.txt to $RUN_DIR"
        mapping_path="$RUN_DIR/mapping-report.txt"
    fi
    local mapping_json_path=""
    if [ -f "$SCRIPT_DIR/mapping-report.json" ]; then
        mv "$SCRIPT_DIR/mapping-report.json" "$RUN_DIR/mapping-report.json" || warn "Could not archive mapping-report.json to $RUN_DIR"
        mapping_json_path="$RUN_DIR/mapping-report.json"
    fi
    local recommendations_path=""
    if [ -f "$SCRIPT_DIR/profile-recommendations.txt" ]; then
        mv "$SCRIPT_DIR/profile-recommendations.txt" "$RUN_DIR/profile-recommendations.txt" || warn "Could not archive profile-recommendations.txt to $RUN_DIR"
        recommendations_path="$RUN_DIR/profile-recommendations.txt"
    fi
    local sanitization_path=""
    if [ -f "$SCRIPT_DIR/sanitization-report.txt" ]; then
        mv "$SCRIPT_DIR/sanitization-report.txt" "$RUN_DIR/sanitization-report.txt" || warn "Could not archive sanitization-report.txt to $RUN_DIR"
        sanitization_path="$RUN_DIR/sanitization-report.txt"
    fi
    local sanitization_json_path=""
    if [ -f "$SCRIPT_DIR/sanitization-report.json" ]; then
        mv "$SCRIPT_DIR/sanitization-report.json" "$RUN_DIR/sanitization-report.json" || warn "Could not archive sanitization-report.json to $RUN_DIR"
        sanitization_json_path="$RUN_DIR/sanitization-report.json"
    fi
    local sanitization_snapshot_path=""
    if [ -f "$SCRIPT_DIR/sanitization-profile.snapshot.toml" ]; then
        mv "$SCRIPT_DIR/sanitization-profile.snapshot.toml" "$RUN_DIR/sanitization-profile.snapshot.toml" || warn "Could not archive sanitization profile snapshot to $RUN_DIR"
        chmod 600 "$RUN_DIR/sanitization-profile.snapshot.toml" 2>/dev/null || true
        sanitization_snapshot_path="$RUN_DIR/sanitization-profile.snapshot.toml"
    elif [ -f "$RUN_DIR/sanitization-profile.snapshot.toml" ]; then
        sanitization_snapshot_path="$RUN_DIR/sanitization-profile.snapshot.toml"
    fi
    if [ -d "$SCRIPT_DIR/payload-previews" ]; then
        mv "$SCRIPT_DIR/payload-previews" "$RUN_DIR/payload-previews" || warn "Could not archive payload previews to $RUN_DIR"
    fi

    local manifest_path=""
    if [ "$COMMAND_LABEL" = "import" ] && [ -f "$RUN_DIR/import-results.json" ]; then
        manifest_path="$RUN_DIR/import-results.json"
    fi
    local snapshot_path=""
    if [ "$COMMAND_LABEL" = "resume" ] && [ -n "${resume_host_path:-}" ] && [ -f "$resume_host_path" ]; then
        cp "$resume_host_path" "$RUN_DIR/import-results.snapshot.json" || warn "Could not archive import-results snapshot to $RUN_DIR"
        chmod 600 "$RUN_DIR/import-results.snapshot.json" 2>/dev/null || true
        snapshot_path="$RUN_DIR/import-results.snapshot.json"
        manifest_path="$resume_host_path"
    fi

    local latest_tmp="$OUTPUT_DIR/.latest.$$"
    if ln -s "$RUN_ID" "$latest_tmp" 2>/dev/null; then
        mv -Tf "$latest_tmp" "$OUTPUT_DIR/latest" 2>/dev/null || rm -f "$latest_tmp"
    fi

    printf '\nCommand finished.\n'
    printf 'Importer exit code: %s\n' "$import_exit_code"
    if [ -n "$log_path" ]; then
        printf 'Log file:\n%s\n' "$log_path"
    else
        printf 'Log file:\n<not created>\n'
    fi
    [ -z "$analysis_path" ] || printf 'Text analysis report:\n%s\n' "$analysis_path"
    [ -z "$analysis_json_path" ] || printf 'JSON analysis report:\n%s\n' "$analysis_json_path"
    [ -z "$discovery_path" ] || printf 'Text discovery report:\n%s\n' "$discovery_path"
    [ -z "$discovery_json_path" ] || printf 'JSON discovery report:\n%s\n' "$discovery_json_path"
    [ -z "$diagnostics_path" ] || printf 'Text diagnostics report:\n%s\n' "$diagnostics_path"
    [ -z "$diagnostics_json_path" ] || printf 'JSON diagnostics report:\n%s\n' "$diagnostics_json_path"
    [ -z "$dry_run_path" ] || printf 'Dry-run report:\n%s\n' "$dry_run_path"
    [ -z "$dry_run_manifest_path" ] || printf 'Dry-run manifest:\n%s\n' "$dry_run_manifest_path"
    [ -z "$verify_path" ] || printf 'Verify report:\n%s\n' "$verify_path"
    [ -z "$verify_json_path" ] || printf 'Verify JSON report:\n%s\n' "$verify_json_path"
    [ -z "$mapping_path" ] || printf 'Text mapping report:\n%s\n' "$mapping_path"
    [ -z "$mapping_json_path" ] || printf 'JSON mapping report:\n%s\n' "$mapping_json_path"
    [ -z "$recommendations_path" ] || printf 'Profile recommendations:\n%s\n' "$recommendations_path"
    [ -z "$sanitization_path" ] || printf 'Text sanitization report:\n%s\n' "$sanitization_path"
    [ -z "$sanitization_json_path" ] || printf 'JSON sanitization report:\n%s\n' "$sanitization_json_path"
    [ -z "$sanitization_snapshot_path" ] || printf 'Sanitization profile snapshot:\n%s\n' "$sanitization_snapshot_path"
    [ -z "$manifest_path" ] || printf 'Import manifest:\n%s\n' "$manifest_path"
    [ -z "$snapshot_path" ] || printf 'Import manifest snapshot:\n%s\n' "$snapshot_path"
}

SCRIPT_DIR="$(resolve_script_dir)" || fail "Unable to resolve the directory containing to-digi." 2
OUTPUT_DIR="$SCRIPT_DIR/output"
TO_DIGI_RS_IMAGE="${TO_DIGI_RS_IMAGE:-$DEFAULT_IMAGE}"
COMMAND_LABEL="$(command_label "$@")"
RUN_ID="run-$(date +%Y%m%d-%H%M%S)-$COMMAND_LABEL"
RUN_DIR="$OUTPUT_DIR/$RUN_ID"
FORWARDED_ARGS=("$@")
resume_host_path=""

require_linux
require_command "$DOCKER_BIN"

if [ "$COMMAND_LABEL" = "pull" ]; then
    printf 'Using image: %s\n' "$TO_DIGI_RS_IMAGE"
    "$DOCKER_BIN" pull "$TO_DIGI_RS_IMAGE"
    exit $?
fi

"$DOCKER_BIN" info >/dev/null 2>&1 || fail "Docker daemon is not reachable. Start Docker or add this user to the docker group." 2

if [ "$COMMAND_LABEL" = "doctor" ]; then
    if has_arg_name "--pull" "$@"; then
        printf 'Pulling selected image: %s\n' "$TO_DIGI_RS_IMAGE"
        "$DOCKER_BIN" pull "$TO_DIGI_RS_IMAGE" || fail "Unable to pull selected image: $TO_DIGI_RS_IMAGE" 2
    else
        "$DOCKER_BIN" image inspect "$TO_DIGI_RS_IMAGE" >/dev/null 2>&1 || fail "Selected Docker image is not available locally. Run ./to-digi pull or ./to-digi doctor --pull." 2
    fi
fi

validate_local_inputs "$COMMAND_LABEL"
mkdir -p "$OUTPUT_DIR" || fail "Unable to create output directory: $OUTPUT_DIR" 2
[ -w "$SCRIPT_DIR" ] || fail "The invoking user cannot write to the deployment directory: $SCRIPT_DIR" 2
[ -w "$OUTPUT_DIR" ] || fail "The invoking user cannot write to the output directory: $OUTPUT_DIR" 2

if [ -e "$RUN_DIR" ]; then
    RUN_ID="${RUN_ID}-$$"
    RUN_DIR="$OUTPUT_DIR/$RUN_ID"
fi
mkdir -p "$RUN_DIR" || fail "Unable to create run output directory: $RUN_DIR" 2

if [ "$COMMAND_LABEL" = "resume" ]; then
    ! has_arg_name "--sanitize-profile" "$@" || fail "--resume cannot be combined with --sanitize-profile." 2
    resume_value="$(resume_arg_value "$@")" || fail "Missing resume manifest." 2
    resume_host_path="$(resolve_safe_deploy_path "$resume_value" "resume manifest")" || exit $?
    [ -w "$resume_host_path" ] || fail "Resume manifest is not writable: $resume_host_path" 2
    translate_resume_args "$(container_path_for_host_path "$resume_host_path")" "$@"
elif [ "${1:-}" = "sanitize" ] && has_arg_name "--sanitize-profile" "$@"; then
    profile_value="$(path_arg_value "--sanitize-profile" "$@")" || fail "Missing value for --sanitize-profile." 2
    profile_host_path="$(resolve_safe_deploy_path "$profile_value" "sanitization profile")" || exit $?
    translate_path_arg "--sanitize-profile" "$(container_path_for_host_path "$profile_host_path")" "$@"
elif [ "${1:-}" = "sanitize" ] && has_arg_name "--profile" "$@"; then
    profile_value="$(path_arg_value "--profile" "$@")" || fail "Missing value for --profile." 2
    case "$profile_value" in
        bigway|starsky) ;;
        */*|*.toml)
            profile_host_path="$(resolve_safe_deploy_path "$profile_value" "sanitization profile")" || exit $?
            translate_path_arg "--profile" "$(container_path_for_host_path "$profile_host_path")" "$@"
            ;;
    esac
elif has_arg_name "--sanitize-profile" "$@"; then
    profile_value="$(path_arg_value "--sanitize-profile" "$@")" || fail "Missing value for --sanitize-profile." 2
    profile_host_path="$(resolve_safe_deploy_path "$profile_value" "sanitization profile")" || exit $?
    translate_path_arg "--sanitize-profile" "$(container_path_for_host_path "$profile_host_path")" "$@"
fi

if [ "$COMMAND_LABEL" = "doctor" ]; then
    FORWARDED_ARGS+=("--inside-container")
fi

if [ "$COMMAND_LABEL" = "import" ]; then
    export TO_DIGI_RS_IMPORT_MANIFEST_PATH="/work/output/$RUN_ID/import-results.json"
else
    export TO_DIGI_RS_IMPORT_MANIFEST_PATH=""
fi

export TO_DIGI_RS_IMAGE
clean_transient_outputs
CONTAINER_OUTPUT_FILE="$RUN_DIR/.container-output.tmp"

printf 'Using image: %s\n' "$TO_DIGI_RS_IMAGE"
printf 'Deployment directory: %s\n' "$SCRIPT_DIR"
printf 'Command: %s\n' "$COMMAND_LABEL"

DOCKER_TTY_ARGS=()
COMMAND_REQUIRES_STDIN=0
if requires_container_stdin "${FORWARDED_ARGS[@]}"; then
    COMMAND_REQUIRES_STDIN=1
fi
if host_stdin_is_tty || [ "$COMMAND_REQUIRES_STDIN" -eq 1 ]; then
    DOCKER_TTY_ARGS+=(--interactive)
fi
if host_stdout_is_tty && [ "$COMMAND_REQUIRES_STDIN" -eq 0 ]; then
    DOCKER_TTY_ARGS+=(--tty)
fi

DOCKER_ARGS=(
    run --rm
    "${DOCKER_TTY_ARGS[@]}"
    --user "$(id -u):$(id -g)"
    --mount "type=bind,src=$SCRIPT_DIR,dst=/work"
    --workdir /work
    --network host
    --security-opt no-new-privileges:true
    --cap-drop ALL
    --env "DIGIWEB_CLIENT_SECRET=${DIGIWEB_CLIENT_SECRET:-}"
    --env "TO_DIGI_RS_CLIENT_SECRET=${TO_DIGI_RS_CLIENT_SECRET:-}"
    --env "TO_DIGI_RS_CLIENT_SECRET_FILE=${TO_DIGI_RS_CLIENT_SECRET_FILE:-}"
    --env "TO_DIGI_RS_BASE_URL=${TO_DIGI_RS_BASE_URL:-}"
    --env "TO_DIGI_RS_STORE_NUMBER=${TO_DIGI_RS_STORE_NUMBER:-}"
    --env "TO_DIGI_RS_ALLOW_INVALID_CERTIFICATES=${TO_DIGI_RS_ALLOW_INVALID_CERTIFICATES:-}"
    --env "TO_DIGI_RS_DEFAULT_PROFILE=${TO_DIGI_RS_DEFAULT_PROFILE:-}"
    --env "TO_DIGI_RS_IMPORT_MANIFEST_PATH=${TO_DIGI_RS_IMPORT_MANIFEST_PATH:-}"
    --env "TO_DIGI_RS_ASCII_PROGRESS=${TO_DIGI_RS_ASCII_PROGRESS:-}"
    --env "COLUMNS=${COLUMNS:-}"
    "$TO_DIGI_RS_IMAGE"
)

(
